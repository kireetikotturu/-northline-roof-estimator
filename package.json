{
  "name": "roof-estimator-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Config-driven roofing estimator & owner panel — root orchestration scripts",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "npm run build --prefix client",
    "seed": "npm run seed --prefix server",
    "start:server": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
