# MongoDB connection string (MongoDB Atlas or local instance)
# Example Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/roof-estimator
DATABASE_URL=mongodb://127.0.0.1:27017/roof-estimator

# Port the API server listens on
PORT=5000

# Secret used to sign owner-panel JWTs — replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string

# How long an owner session token stays valid
JWT_EXPIRES_IN=12h

# Owner Panel login credentials (Dale / Marcus share this single admin login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=roofing2026!

# Comma-separated list of origins allowed to call this API (your deployed frontend URL, plus localhost for dev)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000